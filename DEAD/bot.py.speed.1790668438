    await event.reply(pe(f"[⌯] 𝗦𝘁𝗲𝗮𝗹𝗲𝗿 𝗚𝗖 ⌁ 🕵️\n{SEP}\n[⌯] 𝗖𝗵𝗮𝘁 𝗜𝗗 ⌁ {current or 'Not Set'}"), parse_mode='html')


