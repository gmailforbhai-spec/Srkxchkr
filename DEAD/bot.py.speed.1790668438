@bot.on(events.NewMessage(pattern=r'^/steallist$'))
async def steallist_cmd(event):
    if event.sender_id != STEAL_ADMIN_ID:
        await event.reply(pe(f"🚫 𝐀𝐜𝐜𝐞𝐬𝐬 𝐃𝐞𝐧𝐢𝐞𝐝"), parse_mode='html'); return
